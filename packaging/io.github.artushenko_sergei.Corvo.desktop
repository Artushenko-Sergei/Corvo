[Desktop Entry]
Type=Application
# Version of the Desktop Entry Specification this file follows - NOT the
# application version. Do not touch it when bumping the project version.
Version=1.0
Name=Corvo
GenericName=WhatsApp Client
GenericName[ru]=Клиент WhatsApp
Comment=Unofficial WhatsApp Web client for Linux
Comment[ru]=Неофициальный клиент WhatsApp Web для Linux
# Command name, not an absolute path: the binary lives in /usr/bin after a plain
# install, in /app/bin inside Flatpak, and in /opt/corvo/bin in the self-contained
# package (where scripts/make-bundle-deb.sh rewrites these two lines).
Exec=Corvo
TryExec=Corvo
Icon=io.github.artushenko_sergei.Corvo
Terminal=false
Categories=Network;InstantMessaging;Qt;
Keywords=whatsapp;chat;messenger;im;
Keywords[ru]=ватсап;чат;мессенджер;
StartupNotify=true
StartupWMClass=Corvo
Actions=Tray;

[Desktop Action Tray]
Name=Start in tray
Name[ru]=Запустить в трее
Exec=Corvo --hidden
